# Bridge Course Notes — FRONTEND build-time variables (copy to .env.local for dev).
# Everything here ends up in public browser JavaScript, so ONLY public values belong
# here. Never put RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET or any Supabase
# secret/service-role key in this file — those are Supabase Edge Function secrets
# (see ../supabase/.env.example and docs/SUPABASE_SETUP.md).
#
# In GitHub Actions these come from repository Variables (Settings → Secrets and
# variables → Actions → Variables); see docs/DEPLOYMENT.md.

VITE_SUPABASE_URL=https://ovaubhekxjtkodkhsybg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Checkout receives the key id from the server with each order; this is
# only a fallback. Use the rzp_test_... key until you deliberately switch to live.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Digits only, with country code, e.g. 919876543210. Leave empty to hide WhatsApp buttons.
VITE_WHATSAPP_NUMBER=
VITE_SITE_URL=https://tettesthub.in/bridge-course/
# Optional support email shown on /contact. Leave empty if you don't have one yet.
VITE_SUPPORT_EMAIL=
