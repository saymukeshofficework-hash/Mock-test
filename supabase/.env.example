# Bridge Course Notes — Supabase Edge Function SECRETS (server-side only).
# Set these in Supabase Dashboard → Edge Functions → Secrets, or:
#   supabase secrets set --env-file supabase/.env   (never commit that file)
# SUPABASE_URL / SUPABASE_SECRET_KEYS / SUPABASE_SERVICE_ROLE_KEY are provided by the
# platform automatically — do not set them yourself.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

DOWNLOAD_URL_EXPIRY_SECONDS=300
MAX_DOWNLOADS=5
ACCESS_TOKEN_EXPIRY_DAYS=30
SITE_URL=https://tettesthub.in/bridge-course/
# Comma-separated extra browser origins allowed to call the functions (CORS).
# SITE_URL's origin is always allowed. Defaults to localhost dev servers only.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

PRODUCT_SLUG=bridge-course-notes
# Must equal products.amount_paise in the database (a safety check, see docs).
PRODUCT_AMOUNT_PAISE=19900
PRODUCT_CURRENCY=INR
STORAGE_BUCKET=bridge-course-private
PRODUCT_FILE_PATH=products/bridge-course-notes.pdf
DOWNLOAD_FILE_NAME=Bridge Course Notes by Rakesh Pandey.pdf

MAX_ORDERS_PER_PHONE_PER_HOUR=10
MAX_LOOKUP_FAILURES=10
