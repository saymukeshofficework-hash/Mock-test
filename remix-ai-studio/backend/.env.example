# Copy this file to backend/.env and adjust as needed.
# Run with:  uvicorn main:app --reload --env-file .env

# --- Storage paths (default to backend/uploads, backend/exports, backend/tmp, backend/projects) ---
# REMIX_UPLOAD_DIR=./uploads
# REMIX_EXPORT_DIR=./exports
# REMIX_TMP_DIR=./tmp
# REMIX_PROJECT_DIR=./projects

# --- Upload limits ---
REMIX_MAX_UPLOAD_MB=60
REMIX_MAX_DURATION_SEC=600
REMIX_SAMPLE_RATE=44100

# --- CORS: comma-separated list of allowed frontend origins ---
REMIX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optional ML-based stem separation (Demucs). Requires installing
# backend/requirements-full.txt (pulls in PyTorch, multi-GB). When false or
# not installed, the app automatically falls back to the built-in
# center-channel vocal-isolation heuristic (zero extra dependencies). ---
REMIX_ENABLE_DEMUCS=false

# --- How long uploaded/exported files are kept before the background
# cleanup sweep deletes them (hours) ---
REMIX_FILE_RETENTION_HOURS=6

# --- Mastering target loudness (LUFS), streaming-standard default ---
REMIX_TARGET_LUFS=-14.0
