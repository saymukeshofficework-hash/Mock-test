# Copy to .env for local admin-panel testing (astro dev). Not needed for a normal
# `npm run build` of the public site — only the /admin/ pages and the build-time
# sync script (scripts/sync-admin-posts.mjs) read these. In production these are
# supplied by the GitHub Actions workflow from repo secrets — see
# TECH_BLOG_ADMIN_INSTRUCTIONS.md.
#
# Safe to commit real values here: this is the Supabase "anon" key, which is
# designed to be public — Row Level Security in supabase/blog_admin_schema.sql is
# what actually protects the data, not secrecy of this key.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
