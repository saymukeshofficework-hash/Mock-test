---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../config/categories';
import templateText from '../../../templates/article-template.md?raw';
---

<BaseLayout title="Publish an Article" description="Blog admin panel." path="/admin/" noindex noPagefind>
  <div class="container admin">
    <div class="admin-header">
      <div>
        <h1>Publish an Article</h1>
        <p class="hint">
          Paste a complete article — front matter + body, in the same format as
          <code>tech-blog/templates/article-template.md</code> (already filled in below as a
          starting point). Category must exactly match one of:{' '}
          {categories.map((c, i) => (
            <>
              <code>{c.name}</code>
              {i < categories.length - 1 ? ', ' : ''}
            </>
          ))}.
        </p>
      </div>
      <button id="sign-out" class="btn btn-secondary" hidden>Sign Out</button>
    </div>

    <div id="gate" class="gate">
      <p>Checking session…</p>
    </div>

    <div id="app" hidden>
      <form id="publish-form" class="publish-form">
        <label for="content">Article (front matter + Markdown/HTML body)</label>
        <textarea id="content" required rows="26" spellcheck="false">{templateText}</textarea>

        <div class="form-row">
          <label>
            <input type="radio" name="status" value="draft" checked /> Save as draft
          </label>
          <label>
            <input type="radio" name="status" value="published" /> Publish now
          </label>
        </div>

        <button type="submit" class="btn btn-primary btn-cta">Save</button>
        <p id="publish-status" class="status" role="status"></p>
      </form>

      <p class="note">
        "Publish now" only takes effect once the site rebuilds — instant if you've set up the
        Supabase → GitHub Database Webhook (see TECH_BLOG_ADMIN_INSTRUCTIONS.md), otherwise wait
        for the next push to <code>main</code> or trigger the "Deploy to GitHub Pages" workflow
        manually.
      </p>

      <h2>Existing Submissions</h2>
      <div id="submissions-list" class="submissions-list"><p class="hint">Loading…</p></div>
    </div>
  </div>
</BaseLayout>

<script>
  import { supabase, type BlogSubmission } from '../../lib/supabase-admin';

  const gate = document.getElementById('gate')!;
  const app = document.getElementById('app')!;
  const signOutBtn = document.getElementById('sign-out') as HTMLButtonElement;
  const form = document.getElementById('publish-form') as HTMLFormElement;
  const contentField = document.getElementById('content') as HTMLTextAreaElement;
  const publishStatus = document.getElementById('publish-status')!;
  const listEl = document.getElementById('submissions-list')!;

  init();

  async function init() {
    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      window.location.href = 'login/';
      return;
    }
    gate.hidden = true;
    app.hidden = false;
    signOutBtn.hidden = false;
    await loadSubmissions();
  }

  signOutBtn.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = 'login/';
  });

  // Pulls `slug:` (or falls back to a slugified `title:`) out of pasted front matter.
  function extractSlug(raw: string): string | null {
    const slugMatch = raw.match(/^slug:\s*["']?([a-z0-9-]+)["']?/m);
    if (slugMatch) return slugMatch[1];
    const titleMatch = raw.match(/^title:\s*["']?(.+?)["']?\s*$/m);
    if (!titleMatch) return null;
    return titleMatch[1]
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)/g, '');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const raw = contentField.value;

    if (!raw.trim().startsWith('---')) {
      publishStatus.textContent = 'Missing front matter — the article must start with "---".';
      return;
    }
    const slug = extractSlug(raw);
    if (!slug) {
      publishStatus.textContent = 'Could not find a "slug:" or "title:" line in the front matter.';
      return;
    }

    const status = (form.querySelector('input[name="status"]:checked') as HTMLInputElement).value;
    publishStatus.textContent = 'Saving…';

    const { error } = await supabase
      .from('blog_submissions')
      .upsert({ slug, raw_markdown: raw, status }, { onConflict: 'slug' });

    if (error) {
      publishStatus.textContent = `Error: ${error.message}`;
      return;
    }
    publishStatus.textContent = `Saved as ${status === 'published' ? 'published' : 'draft'} (slug: ${slug}).`;
    await loadSubmissions();
  });

  async function loadSubmissions() {
    const { data, error } = await supabase
      .from('blog_submissions')
      .select('id, slug, status, updated_at')
      .order('updated_at', { ascending: false });

    if (error) {
      listEl.innerHTML = `<p class="hint">Could not load submissions: ${error.message}</p>`;
      return;
    }
    if (!data || data.length === 0) {
      listEl.innerHTML = '<p class="hint">No submissions yet.</p>';
      return;
    }
    listEl.innerHTML = '';
    for (const row of data as Pick<BlogSubmission, 'id' | 'slug' | 'status' | 'updated_at'>[]) {
      const item = document.createElement('div');
      item.className = 'submission-row';
      item.innerHTML = `
        <span class="pill">${row.status}</span>
        <span class="slug">${row.slug}</span>
        <span class="hint">${new Date(row.updated_at).toLocaleString()}</span>
        <button type="button" class="btn btn-secondary edit-btn">Edit</button>
        <button type="button" class="btn btn-secondary delete-btn">Delete</button>
      `;
      item.querySelector('.edit-btn')!.addEventListener('click', async () => {
        const { data: full, error: fetchErr } = await supabase
          .from('blog_submissions')
          .select('raw_markdown')
          .eq('id', row.id)
          .single();
        if (fetchErr || !full) {
          publishStatus.textContent = `Could not load: ${fetchErr?.message ?? 'unknown error'}`;
          return;
        }
        contentField.value = full.raw_markdown;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      item.querySelector('.delete-btn')!.addEventListener('click', async () => {
        if (!confirm(`Delete "${row.slug}"? This cannot be undone.`)) return;
        const { error: delErr } = await supabase.from('blog_submissions').delete().eq('id', row.id);
        if (delErr) {
          publishStatus.textContent = `Could not delete: ${delErr.message}`;
          return;
        }
        await loadSubmissions();
      });
      listEl.appendChild(item);
    }
  }
</script>

<style>
  /* .btn sets display:inline-flex in global.css at equal specificity to the
     browser's default [hidden]{display:none}, and wins on cascade order —
     so the native hidden attribute alone won't hide a .btn. Force it here. */
  #sign-out[hidden] { display: none; }

  .admin { padding: 2.5rem 0 4rem; max-width: 820px; }
  .admin-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .hint { color: var(--ink-faint); font-size: 0.85rem; }
  .hint code, .note code { background: var(--paper-soft); padding: 0.1em 0.4em; border-radius: 4px; font-size: 0.85em; }
  .gate { padding: 3rem 0; color: var(--ink-faint); }
  .publish-form { display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.5rem; }
  .publish-form label { font-weight: 700; font-size: 0.85rem; }
  #content {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.85rem;
    line-height: 1.5;
    padding: 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    resize: vertical;
    width: 100%;
  }
  .form-row { display: flex; gap: 1.5rem; font-weight: 600; font-size: 0.9rem; }
  .form-row label { display: flex; align-items: center; gap: 0.4em; font-weight: 600; }
  .publish-form .btn { align-self: flex-start; }
  .status { color: var(--ink-dim); font-size: 0.85rem; min-height: 1.2em; }
  .note { color: var(--ink-faint); font-size: 0.82rem; margin-top: 0.5rem; }
  .submissions-list { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 1rem; }
  .submission-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    flex-wrap: wrap;
  }
  .submission-row .slug { font-weight: 700; }
  .submission-row .hint { margin-left: auto; }
</style>
