---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="Page Not Found" description="The page you're looking for doesn't exist." path="/404/" noindex>
  <div class="container not-found">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or may have moved.</p>
    <a href={withBase('/')} class="btn btn-primary">Back to homepage</a>
  </div>
</BaseLayout>

<style>
  .not-found { text-align: center; padding: 6rem 1.25rem; }
  .not-found .btn { margin-top: 1.5rem; }
</style>
