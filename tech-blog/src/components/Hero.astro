---
import type { Post } from '../lib/posts';
import { withBase, formatDate } from '../lib/url';
import { getCategoryByName } from '../config/categories';
import { siteConfig } from '../config/site';

interface Props { featured: Post }
const { featured } = Astro.props;
const category = getCategoryByName(featured.data.category);
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">{siteConfig.BLOG_TAGLINE}</p>
      {category && <a href={withBase(`/category/${category.slug}/`)} class="pill">{category.name}</a>}
      <h1><a href={withBase(`/posts/${featured.slug}/`)}>{featured.data.title}</a></h1>
      <p class="hero-excerpt">{featured.data.description}</p>
      <p class="hero-meta">
        <time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time>
        {featured.data.readingTime && <> · {featured.data.readingTime} min read</>}
      </p>
      <a href={withBase(`/posts/${featured.slug}/`)} class="btn btn-primary">Read the Article</a>
    </div>
    <a href={withBase(`/posts/${featured.slug}/`)} class="hero-image-link">
      <img src={withBase(featured.data.featuredImage)} alt={featured.data.featuredImageAlt} width="800" height="600" />
    </a>
  </div>
</section>

<style>
  .hero { position: relative; padding: 3.5rem 0 4rem; border-bottom: 1px solid var(--border); overflow: hidden; }
  .hero::before {
    content: '';
    position: absolute;
    top: -25%;
    right: -12%;
    width: 480px;
    height: 480px;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 22%, transparent) 0%, transparent 70%);
    pointer-events: none;
  }
  .hero-grid { position: relative; z-index: 1; display: grid; gap: 2rem; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .hero-grid { grid-template-columns: 1.1fr 0.9fr; } }
  .hero-copy .pill { margin: 0.5em 0 0.8em; }
  .hero-copy h1 { margin: 0 0 0.5em; }
  .hero-copy h1 a { color: var(--ink); }
  .hero-copy h1 a:hover { color: var(--color-accent-strong); text-decoration: none; }
  .hero-excerpt { color: var(--ink-dim); font-size: 1.1rem; }
  .hero-meta { color: var(--ink-faint); font-size: 0.85rem; margin-bottom: 1.5em; }
  .hero-image-link { display: block; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4/3; background: var(--paper-soft); box-shadow: var(--shadow-lg); }
  .hero-image-link img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .hero-image-link:hover img { transform: scale(1.04); }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > *, .hero-image-link { animation: hero-fade-up 0.7s var(--ease) both; }
    .hero-copy > *:nth-child(1) { animation-delay: 0s; }
    .hero-copy > *:nth-child(2) { animation-delay: 0.06s; }
    .hero-copy > *:nth-child(3) { animation-delay: 0.12s; }
    .hero-copy > *:nth-child(4) { animation-delay: 0.18s; }
    .hero-copy > *:nth-child(5) { animation-delay: 0.24s; }
    .hero-image-link { animation-delay: 0.15s; }
  }
  @keyframes hero-fade-up {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
