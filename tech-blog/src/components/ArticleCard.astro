---
import type { Post } from '../lib/posts';
import { withBase, formatDate } from '../lib/url';
import { getCategoryByName } from '../config/categories';

interface Props { post: Post; horizontal?: boolean }
const { post, horizontal = false } = Astro.props;
const category = getCategoryByName(post.data.category);
---

<article class:list={['article-card', { horizontal }]}>
  <a href={withBase(`/posts/${post.slug}/`)} class="thumb-link">
    <img src={withBase(post.data.featuredImage)} alt={post.data.featuredImageAlt} loading="lazy" width="640" height="360" />
  </a>
  <div class="card-body">
    {category && (
      <a href={withBase(`/category/${category.slug}/`)} class="pill">{category.name}</a>
    )}
    <h3><a href={withBase(`/posts/${post.slug}/`)}>{post.data.title}</a></h3>
    <p class="excerpt">{post.data.description}</p>
    <p class="meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.readingTime && <span> · {post.data.readingTime} min read</span>}
    </p>
  </div>
</article>

<style>
  .article-card { display: flex; flex-direction: column; }
  .article-card.horizontal { flex-direction: row; gap: 1rem; }
  .thumb-link { border-radius: var(--radius); overflow: hidden; aspect-ratio: 16/9; background: var(--paper-soft); }
  .article-card.horizontal .thumb-link { width: 140px; flex-shrink: 0; }
  .thumb-link img { width: 100%; height: 100%; object-fit: cover; }
  .card-body { padding: 0.9rem 0.1rem; }
  .card-body .pill { margin-bottom: 0.6em; }
  .card-body h3 { font-size: 1.1rem; margin: 0.2em 0 0.3em; }
  .card-body h3 a { color: var(--ink); }
  .card-body h3 a:hover { color: var(--color-accent-strong); text-decoration: none; }
  .excerpt { color: var(--ink-dim); font-size: 0.92rem; margin: 0 0 0.5em; }
  .meta { color: var(--ink-faint); font-size: 0.8rem; margin: 0; }
</style>
