# Copy to .env.local and fill in. Never commit real values.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Contact details shown on /contact only when set
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_WHATSAPP_URL=

# Contact form delivery: any webhook that accepts JSON (Zapier, Make, Slack, Discord, email service)
CONTACT_WEBHOOK_URL=

# Analytics (leave empty to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Payments — Phase 6 (server-side only; never prefix the secret with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Database — Phase 6/7
DATABASE_URL=
